<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="MyTravelLog.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:helpers="clr-namespace:MyTravelLog.Helpers">

    <Application.Resources>
        <ResourceDictionary>

            <!-- Merge colour palette and shared styles -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Value converters available on every page -->
            <helpers:StringToBoolConverter    x:Key="StringToBoolConverter" />
            <helpers:InverseBoolConverter     x:Key="InverseBoolConverter" />
            <helpers:NullToBoolConverter      x:Key="NullToBoolConverter" />
            <helpers:BoolToSpeakIconConverter x:Key="BoolToSpeakIconConverter" />

        </ResourceDictionary>
    </Application.Resources>

</Application>
